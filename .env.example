# Soal AI: gunakan endpoint chat-completions yang kompatibel dengan format OpenAI.
# Feature off sampai endpoint, model, dan secret key dikonfigurasi.
AI_QUESTIONS_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_QUESTIONS_PER_LESSON=12
AI_QUESTIONS_RETENTION_DAYS=30
AI_QUESTIONS_BATCH_SIZE=1000
AI_QUESTIONS_SCHEDULE_CRON=0 59 23 * * SUN
AI_QUESTIONS_SCHEDULE_ZONE=Asia/Jakarta
